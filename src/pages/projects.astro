---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import photos from "../data/photos.json";

const title = "Building Work Photos | MGC Building Ltd";
const description =
  "90 photos from MGC Building Ltd jobs: extensions, lofts, interiors, groundworks, driveways and garden buildings. Based in Shortstown, Bedford.";

const filters = [
  { id: "all", label: "All photos" },
  { id: "extension", label: "Extensions" },
  { id: "loft", label: "Lofts" },
  { id: "interior", label: "Inside the house" },
  { id: "groundworks", label: "Groundworks" },
  { id: "driveway", label: "Drives and paths" },
  { id: "garden", label: "Garden buildings" },
];
---

<Base title={title} description={description}>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs items={[{ href: "/", label: "Home" }, { label: "Work" }]} />
      <p class="eyebrow">Work</p>
      <h1>Photos from our own jobs.</h1>
      <p class="lede">
        These are our site photos, including the set published on our Bark profile. A lot of them are mid-build.
        That is when you can see the steels, the trenches and the roof, not just the sofa at the end.
      </p>
      <div class="filters" role="toolbar" aria-label="Filter photos">
        {filters.map((filter) => (
          <button type="button" data-filter={filter.id} aria-pressed={filter.id === "all" ? "true" : "false"}>
            {filter.label}
          </button>
        ))}
      </div>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="gallery">
        {photos.map((photo) => (
          <button type="button" data-cat={photo.cat} data-full={photo.src} data-alt={photo.alt}>
            <img
              src={photo.sm}
              srcset={photo.w > 800 ? `${photo.sm} 800w, ${photo.src} ${photo.w}w` : undefined}
              sizes="(max-width: 700px) 100vw, 33vw"
              width={photo.w}
              height={photo.h}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
    </div>
  </section>
  <dialog class="lightbox" id="lightbox">
    <form method="dialog">
      <button class="btn btn-line" type="submit">Close</button>
    </form>
    <img id="lightbox-img" alt="" />
  </dialog>
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLButtonElement>("[data-cat]");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      items.forEach((item) => {
        item.hidden = filter !== "all" && item.dataset.cat !== filter;
      });
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  const image = document.querySelector<HTMLImageElement>("#lightbox-img");
  items.forEach((item) => {
    item.addEventListener("click", () => {
      if (!dialog || !image) return;
      image.src = item.dataset.full || "";
      image.alt = item.dataset.alt || "";
      dialog.showModal();
    });
  });
</script>
