---
import { site } from "../data/site";
import { services } from "../data/services";
import { areas } from "../data/areas";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a class="logo" href="/" aria-label="MGC Building Ltd, home">
        <img src="/images/logo.png" alt="" width="878" height="337" />
      </a>
      <p>
        Builders based at {site.address.street}, {site.address.locality}, {site.address.region} {site.address.postcode}.
        Extensions, lofts, new homes, driveways and landscaping across {site.counties.join(", ")}.
      </p>
      <div class="socials">
        <a href="https://www.instagram.com/mgcbuilding" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 4.6A4.4 4.4 0 1 0 16.4 12 4.4 4.4 0 0 0 12 7.6zm6.1-.9a1 1 0 1 0 1 1 1 1 0 0 0-1-1zM12 9.2A2.8 2.8 0 1 1 9.2 12 2.8 2.8 0 0 1 12 9.2z"/></svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61553789703180" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.6l.4-3H13v-2c0-.6.4-1 1-1z"/></svg>
        </a>
        <a href="https://www.bark.com/en/gb/company/mgc-building-ltd/POeVn/" target="_blank" rel="noopener noreferrer" aria-label="Bark">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3 4 7v5c0 4.4 3.1 7.6 8 9 4.9-1.4 8-4.6 8-9V7zm0 2.2 6 3V12c0 3.4-2.3 6-6 7.3C8.3 18 6 15.4 6 12V8.2z"/></svg>
        </a>
        <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Google Maps">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <h2>Pages</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/projects">Work</a></li>
        <li><a href="/areas">Areas</a></li>
        <li><a href="/reviews">Reviews</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <h2>Services</h2>
      <ul>
        {services.map((service) => (
          <li><a href={`/services/${service.slug}`}>{service.nav}</a></li>
        ))}
        <li><a href={site.hireUrl} target="_blank" rel="noopener noreferrer">Tool hire</a></li>
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
            {site.address.street}, {site.address.locality}, {site.address.postcode}
          </a>
        </li>
        <li>Monday to Saturday, 7:30am to 6:30pm</li>
        <li>Sunday closed</li>
        <li><a href="https://www.mybuilder.com/profile/mgc_building_ltd" target="_blank" rel="noopener noreferrer">MyBuilder profile</a></li>
      </ul>
      <h2 style="margin-top:1.2rem">Towns</h2>
      <ul>
        {areas.slice(0, 6).map((area) => (
          <li><a href={`/areas/${area.slug}`}>{area.name}</a></li>
        ))}
        <li><a href="/areas">All areas</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>
      <a href="/privacy">Privacy</a>
      {" · "}
      <a href="/cookies">Cookies</a>
    </p>
  </div>
</footer>
