---
import "@fontsource-variable/outfit";
import "@fontsource/fraunces/600-italic.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { localBusinessSchema, site } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  preload?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og.jpg",
  preload,
  noindex = false,
  schema = [],
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path === "/" ? "/" : path, site.url).href;
const imageUrl = new URL(image, site.url).href;
const graph = {
  "@context": "https://schema.org",
  "@graph": [localBusinessSchema(), ...schema],
};
const json = JSON.stringify(graph).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#08090d" />
    <meta name="geo.region" content="GB-BDF" />
    <meta name="geo.placename" content="Shortstown, Bedford" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    <script type="application/ld+json" set:html={json} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
